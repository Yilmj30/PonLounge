# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Public site URL, used for metadata (Open Graph, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# "production" enables search-engine indexing (robots.ts). Anything else
# (e.g. "preview", "development") keeps the site out of search results —
# useful while the real content/branding is still being finalized.
NEXT_PUBLIC_ENV=development

# --- Contact details (shown across the site + used for reservations) ---
# WhatsApp number in E.164 format, no "+", used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
# Same number, formatted for display.
NEXT_PUBLIC_PHONE_DISPLAY=+57 300 000 0000
# Automatic reservations address on our own domain (ponlounge.com) — used
# by the "reservar por correo" mailto button and processed automatically
# by the email webhook. Nobody checks this as a real inbox; staff gets
# notified of every reservation via STAFF_NOTIFICATION_EMAIL instead.
# Never change this to a Gmail/Outlook address — those can't receive
# Resend's inbound webhook, which breaks automatic email bookings.
NEXT_PUBLIC_RESERVATIONS_EMAIL=hola@ponlounge.com
# Street address — shown in the footer, the "Ubicación" section, embedded
# in the Google Maps iframe (as the search query), and in the LocalBusiness
# structured data used for SEO.
NEXT_PUBLIC_ADDRESS=Cra 44 #20-28, Distrito Vera, El Poblado, Medellín, Colombia

# --- Social links (shown in the footer) ---
# Leave unset until the client shares the real handles — the footer icon
# only renders once its URL is set, rather than linking to "#".
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Database (Postgres / Neon) ---
# Powers reservations, deposits, and the editable menu at /admin/carta.
# Without this, reservations still work but fall back to a local,
# file-simulated database instead. Get this from neon.tech → your project
# → Connect. Set the same value in the VPS's real .env.local, then run
# the project's db setup script once.
DATABASE_URL=

# --- Email (Resend) ---
# API key from resend.com with Sending AND Receiving access.
RESEND_API_KEY=
# Signing secret shown when creating the Resend webhook (Receiving →
# email.received event, pointed at https://yourdomain.com/api/email-webhook).
# Required for the automatic "reservar por correo" flow to work.
RESEND_WEBHOOK_SECRET=
# Real staff inbox (e.g. a Gmail) that gets a copy of every reservation —
# both from the website form and the email flow. This is the address the
# team actually checks day to day. Leave empty during development/testing
# so test reservations don't spam a real inbox.
STAFF_NOTIFICATION_EMAIL=

# --- Admin panel (/admin) ---
# Shared password for the deposit-review and menu-editor panels. Set a
# strong real value before going live — the placeholder below is for
# local development only.
ADMIN_PASSWORD=ponlounge-admin